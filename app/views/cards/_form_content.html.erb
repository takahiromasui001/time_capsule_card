<div id="card_form_content" class="bg-white rounded-lg shadow-xl max-w-md w-full p-6">
  <div class="flex justify-between items-center mb-4">
    <h2 class="text-2xl font-bold">新しいカードを投函</h2>
    <button type="button" data-action="click->card-form#close" class="text-gray-500 hover:text-gray-700">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <%= form_with model: card, data: { action: "turbo:submit-end->card-form#handleSubmit" } do |f| %>
    <div class="mb-4">
      <%= f.label :title, "タイトル", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= f.text_field :title, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500", placeholder: "未来の自分へのメッセージ" %>
      <%= render 'shared/field_error', record: card, field: :title %>
    </div>

    <div class="mb-4">
      <%= f.label :content, "内容", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= f.text_area :content, rows: 4, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500", placeholder: "詳細な内容（任意）" %>
      <%= render 'shared/field_error', record: card, field: :content %>
    </div>

    <div class="mb-6">
      <%= f.label :scheduled_at, "配達日時", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= f.datetime_local_field :scheduled_at, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      <%= render 'shared/field_error', record: card, field: :scheduled_at %>
    </div>

    <div class="flex justify-end gap-3">
      <button type="button" data-action="click->card-form#close" class="px-4 py-2 text-gray-700 bg-gray-200 rounded-md hover:bg-gray-300">
        キャンセル
      </button>
      <%= f.submit "投函する", class: "px-4 py-2 text-white bg-blue-500 rounded-md hover:bg-blue-600" %>
    </div>
  <% end %>
</div>
