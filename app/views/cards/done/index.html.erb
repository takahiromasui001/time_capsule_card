<div class="w-full max-w-4xl mx-auto px-4" data-controller="card-form">
  <%= render 'cards/shared/tabs', current_tab: 'done' %>

  <% if @cards.any? %>
    <div class="space-y-3">
      <% @cards.each do |card| %>
        <%= render 'cards/shared/list_card', card:, date_label: '完了日', date_value: card.completed_at, editable: true %>
      <% end %>
    </div>

    <div class="mt-6">
      <%== @pagy.series_nav %>
    </div>
  <% else %>
    <div class="text-gray-500 text-center mt-8">
      完了済みのカードがありません
    </div>
  <% end %>

  <!-- Card Form Modal -->
  <%= render 'cards/form', card: current_user.cards.build %>
</div>
