<div class="max-w-4xl mx-auto">
  <%= render 'cards/shared/tabs', current_tab: 'done' %>

  <% if @cards.any? %>
    <div class="space-y-3">
      <% @cards.each do |card| %>
        <%= render 'cards/shared/list_card', card: card, date_label: '完了日', date_value: card.completed_at %>
      <% end %>
    </div>
  <% else %>
    <div class="text-gray-500 text-center mt-8">
      完了済みのカードがありません
    </div>
  <% end %>
</div>
