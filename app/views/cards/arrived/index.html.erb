<div class="max-w-4xl mx-auto">
  <%= render 'cards/shared/tabs', current_tab: 'arrived' %>

  <% if @cards.any? %>
    <div class="space-y-3">
      <% @cards.each do |card| %>
        <div class="bg-white rounded-lg shadow-md p-4">
          <h3 class="text-lg font-bold text-gray-800"><%= card.title %></h3>
          <% if card.content.present? %>
            <p class="text-gray-600 mt-2"><%= card.content %></p>
          <% end %>
          <p class="text-xs text-gray-400 mt-2">
            到着日: <%= card.scheduled_at.strftime('%Y年%m月%d日') %>
          </p>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-gray-500 text-center mt-8">
      到着済みのカードがありません
    </div>
  <% end %>
</div>
