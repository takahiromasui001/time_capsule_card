<div class="w-full max-w-4xl mx-auto px-4">
  <%= render 'cards/shared/tabs', current_tab: 'arrived' %>

  <% if @cards.any? %>
    <div class="space-y-3">
      <% @cards.each do |card| %>
        <%= render 'cards/shared/list_card', card: card, date_label: '到着日', date_value: card.scheduled_at %>
      <% end %>
    </div>
  <% else %>
    <div class="text-gray-500 text-center mt-8">
      到着済みのカードがありません
    </div>
  <% end %>
</div>
