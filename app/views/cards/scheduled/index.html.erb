<div class="w-full max-w-4xl mx-auto px-4" data-controller="card-form">
  <%= render 'cards/shared/tabs', current_tab: 'scheduled' %>

  <div class="flex gap-2 mb-6">
    <% scheduled_periods.each do |period| %>
      <% active = @current_period == period[:key] %>
      <%= link_to period[:label], cards_scheduled_index_path(period: period[:key]),
          class: "px-4 py-2 rounded #{active ? 'bg-blue-500 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'}" %>
    <% end %>
  </div>

  <% if @cards.any? %>
    <div class="space-y-3">
      <% @cards.each do |card| %>
        <%= render 'cards/shared/list_card', card: card, date_label: '到着予定', date_value: card.scheduled_at, editable: true %>
      <% end %>
    </div>
  <% else %>
    <div class="text-gray-500 text-center mt-8">
      投函済みのカードがありません
    </div>
  <% end %>

  <!-- Card Form Modal -->
  <%= render 'cards/form', card: current_user.cards.build %>
</div>
