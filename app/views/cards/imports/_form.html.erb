<div id="import_form_modal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 <%= 'hidden' unless local_assigns[:errors]&.any? %>" data-import-form-target="modal">
  <div class="bg-white rounded-lg shadow-xl max-w-md w-full p-6">
    <div class="flex justify-between items-center mb-4">
      <h2 class="text-2xl font-bold">CSVインポート</h2>
      <button type="button" data-action="click->import-form#close" class="text-gray-500 hover:text-gray-700">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <% if local_assigns[:errors]&.any? %>
      <div class="mb-4 p-3 bg-red-100 text-red-700 rounded">
        <ul class="list-disc list-inside text-sm">
          <% errors.each do |error| %>
            <li><%= error %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with url: cards_import_path, method: :post, data: { action: 'turbo:submit-end->import-form#handleSubmit' } do |f| %>
      <div class="mb-4">
        <%= f.label :file, 'CSVファイル', class: 'block text-sm font-medium text-gray-700 mb-2' %>
        <%= f.file_field :file, accept: '.csv', class: 'w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500' %>
      </div>
      <p class="text-xs text-gray-500 mb-4">カラム: title, content, scheduled_at, status</p>

      <div class="flex justify-end gap-3">
        <button type="button" data-action="click->import-form#close" class="px-4 py-2 text-gray-700 bg-gray-200 rounded-md hover:bg-gray-300">
          キャンセル
        </button>
        <%= f.submit 'インポート', class: 'px-4 py-2 text-white bg-blue-500 rounded-md hover:bg-blue-600 cursor-pointer' %>
      </div>
    <% end %>
  </div>
</div>
