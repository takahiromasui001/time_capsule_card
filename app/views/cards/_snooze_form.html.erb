<div id="snooze-form-<%= card.id %>" class="hidden mt-3">
  <%= form_with url: card_triage_path(card), method: :post, data: { turbo_frame: "_top" } do |f| %>
    <%= f.hidden_field :destination, value: 'scheduled' %>
    <div class="mb-2">
      <%= f.label :scheduled_at, "新しい配達日時", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.datetime_local_field :scheduled_at, class: "w-full px-2 py-1 border border-gray-300 rounded-md text-sm", min: Time.current.strftime("%Y-%m-%dT%H:%M") %>
    </div>
    <div class="flex gap-2">
      <button type="button" data-action="click->card#hideSnoozeForm" data-card-id="<%= card.id %>" class="px-3 py-1 bg-gray-200 text-gray-700 rounded-md hover:bg-gray-300 text-sm">
        キャンセル
      </button>
      <%= f.submit "設定", class: "px-3 py-1 bg-blue-500 text-white rounded-md hover:bg-blue-600 text-sm" %>
    </div>
  <% end %>
</div>
