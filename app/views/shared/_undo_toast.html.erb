<div id="undo_toast" class="fixed bottom-20 left-1/2 transform -translate-x-1/2 bg-white text-gray-800 px-4 py-3 rounded-lg shadow-xl border border-gray-200 flex items-center gap-4 z-50 whitespace-nowrap" data-controller="toast">
  <span>完了しました</span>
  <%= button_to '取り消す', card_archive_path(card), method: :delete, class: 'text-blue-500 hover:text-blue-700 font-medium', data: { action: 'toast#cancel' } %>
  <button type="button" class="text-gray-300 hover:text-gray-500 text-xs" data-action="toast#close">✕</button>
</div>
