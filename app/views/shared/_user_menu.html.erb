<div class="relative" data-controller="dropdown">
  <button type="button" data-action="click->dropdown#toggle" class="w-8 h-8 bg-gray-300 rounded-full flex items-center justify-center hover:bg-gray-400">
    <span class="text-gray-600 text-sm font-medium"><%= current_user.name.first.upcase %></span>
  </button>
  <div data-dropdown-target="menu" class="hidden absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg py-1 z-10">
    <%= link_to 'CSVエクスポート', cards_export_path(format: :csv), class: 'block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100' %>
    <%= button_to 'Logout', logout_path, method: :delete, class: 'w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100' %>
  </div>
</div>
