<% flash.each do |type, message| %>
  <% bg_color = type == 'notice' ? 'bg-green-500' : 'bg-red-500' %>
  <div class="fixed top-4 right-4 z-50 max-w-md">
    <div class="<%= bg_color %> text-white px-6 py-3 rounded-lg shadow-lg mb-2 flex items-center justify-between" data-controller="flash">
      <span><%= message %></span>
      <button type="button" class="ml-4 text-white hover:text-gray-200" data-action="click->flash#remove">
        ✕
      </button>
    </div>
  </div>
<% end %>
